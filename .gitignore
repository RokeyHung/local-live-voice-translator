# Node / Electron
node_modules/
dist/
dist-electron/
release/
*.local

# Python
.venv/
__pycache__/
*.pyc
.uv/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Models & data (không commit model lớn / dữ liệu phiên)
models/
*.gguf
*.onnx
*.bin
data/
*.sqlite
*.sqlite3

# Audio tham chiếu của bộ đo độ chính xác: là dữ liệu giọng nói, không commit.
apps/ai-service/scripts/audio/*
!apps/ai-service/scripts/audio/README.md
soak*.json
# Kết quả bộ đánh giá FLEURS (docs/17) — số liệu của từng máy, không chép vào repo
eval-*.json
# Ngoại lệ: các lượt đã chốt và đã trích vào tài liệu thì commit, để người đọc báo cáo
# kiểm lại được từng con số. Xem docs/results/README.md.
!docs/results/*.json
!docs/results/model-selection/*.json
# Cache dữ liệu FLEURS tải về (scripts/fetch_fleurs.sh) — vài GB audio, tải lại được.
fleurs-cache/

# Bản Word xuất từ docs/ (make docx). Nhị phân, không xem được bằng git diff, và dựng
# lại được từ file .md nguồn — nguồn duy nhất vẫn là Markdown.
docs/word/

# Bản ghi nguồn thả tạm vào repo để cắt bộ câu.
*.mov
*.mp4
*.m4a
*.mp3
*.wav

# OS / editor
.DS_Store
Thumbs.db
.idea/
*.log

/TranscriptionSuite
# tsc --composite sinh ra khi chạy typecheck bằng tay (npm run typecheck đã tắt bằng
# --composite false, nhưng gọi tsc trực tiếp thì không).
*.tsbuildinfo
